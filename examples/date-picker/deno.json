{
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "check": "deno check src/index.ts"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "cosuous": "jsr:@usagi-computer/cosuous@^0.1.5",
    "cosuous/signal": "jsr:@usagi-computer/cosuous@^0.1.5/signal",
    "temporal-polyfill-lite": "npm:temporal-polyfill-lite@^0.4.0",
    "vite": "npm:vite@^8"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"]
  }
}
